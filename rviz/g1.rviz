Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LiDAR1
        - /Detections1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: World
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.3

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 15

    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /livox/mid360/points
        Depth: 1
        # Must match the publisher's best-effort QoS or no points arrive.
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      # Non-repetitive Mid-360 scan: a single frame is a thin slice, not a
      # full ring. Accumulate a few seconds so coverage is visible at all.
      Decay Time: 3

    - Class: rviz_default_plugins/MarkerArray
      Name: Detections
      Enabled: true
      Topic:
        Value: /g1/detection_markers
        Depth: 10
        Reliability Policy: Reliable
      Namespaces:
        {}

    - Class: rviz_default_plugins/Image
      Name: CameraRGB
      Enabled: true
      Topic:
        Value: /g1/camera/rgb
        Depth: 1
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /g1/odom
        Depth: 10
        Reliability Policy: Reliable
      Keep: 100
      Shape:
        Alpha: 0.5
        Color: 255; 200; 0
        Value: Arrow

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 25
      Focal Point:
        X: 8
        Y: 0
        Z: 0
      Pitch: 0.4
      Yaw: 3.0
      Target Frame: odom
    Saved: ~

Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
  CameraRGB:
    collapsed: false
